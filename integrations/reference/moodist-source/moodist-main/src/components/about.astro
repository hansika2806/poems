---
import { Container } from '@/components/container';

import { count as soundCount } from '@/lib/sounds';

const count = soundCount();

const paragraphs = [
  {
    body: 'No subscriptions, registrations, or distractions. Open Moodist and start shaping a space that feels right for you.',
    title: 'Free by design',
  },
  {
    body: `Explore ${count} carefully selected sounds from nature, familiar places, color noise, and focused listening tools.`,
    title: 'Carefully curated',
  },
  {
    body: 'Layer rain with a distant train, birds with a stream, or anything else you imagine. Every mix is yours to tune.',
    title: 'Make it your own',
  },
  {
    body: 'Use it to focus, read, unwind, meditate, or fall asleep. Your soundscape can change whenever your day does.',
    title: 'Ready for every moment',
  },
];
---

<section class="about">
  <Container>
    <header class="header">
      <h2>A calmer space, shaped by sound.</h2>
      <p class="intro">
        Moodist keeps ambient listening simple: choose a few sounds, find the
        right balance, and let the rest fade into the background.
      </p>
    </header>

    <div class="grid">
      {
        paragraphs.map((paragraph, index) => (
          <article class="paragraph">
            <p class="counter" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </p>
            <div>
              <h3 class="title">{paragraph.title}</h3>
              <p class="body">{paragraph.body}</p>
            </div>
          </article>
        ))
      }
    </div>

    <button class="button" id="use-moodist">Start mixing sounds</button>
  </Container>
</section>

<script lang="ts">
  const button = document.getElementById('use-moodist');

  button?.addEventListener('click', () => {
    document.getElementById('app')?.scrollIntoView();
  });
</script>

<style>
  .about {
    padding: 120px 0 80px;

    & .header {
      max-width: 620px;
      margin-bottom: 64px;

      & h2 {
        max-width: 560px;
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 6vw, 3.75rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.035em;
        text-wrap: balance;
      }

      & .intro {
        max-width: 540px;
        margin-top: 22px;
        font-size: var(--font-md);
        line-height: 1.6;
        color: var(--color-foreground-subtle);
      }
    }

    & .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }

    & .paragraph {
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr);
      column-gap: 16px;
      padding: 28px 0 32px;
      border-bottom: 1px solid var(--color-border);

      & .counter {
        font-size: var(--font-xsm);
        font-variant-numeric: tabular-nums;
        color: var(--color-foreground-subtle);
      }

      & .title {
        margin-bottom: 10px;
        font-family: var(--font-heading);
        font-size: var(--font-base);
        font-weight: 600;
      }

      & .body {
        line-height: 1.6;
        color: var(--color-foreground-subtle);
      }
    }

    & .button {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0 18px;
      margin-top: 36px;
      font-size: var(--font-xsm);
      font-weight: 500;
      color: var(--color-inverted-foreground);
      cursor: pointer;
      background-color: var(--color-inverted-background);
      border: 1px solid var(--color-inverted-background);
      border-radius: 50px;
      outline: none;
      transition: background-color 180ms ease;

      &:hover,
      &:focus-visible {
        background-color: var(--color-inverted-background-hover);
      }

      &:focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 2px;
      }
    }
  }

  @media (width <= 600px) {
    .about {
      padding: 88px 0 64px;

      & .header {
        margin-bottom: 44px;

        & h2 {
          font-size: clamp(2.15rem, 11vw, 3rem);
        }

        & .intro {
          font-size: var(--font-base);
        }
      }

      & .grid {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
